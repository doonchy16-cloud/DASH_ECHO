{
  "geode": "5.10.1",
  "gd": {
    "win": "2.2081"
  },
  "id": "doonchy.dash-echo",
  "name": "ECHO_DASH",
  "version": "v1.1.3",
  "developer": "Doonchy",
  "description": "Every attempt leaves a trace. Persistent multighost replay, trail-based Last/Best identity, death intelligence, Replay Studio, and cinematic analysis for Geometry Dash.",
  "tags": ["gameplay", "interface", "customization", "utility"],
  "settings": {
    "ghosts-title": {
      "type": "title",
      "name": "Ghost Multiverse"
    },
    "ghost-count": {
      "type": "int",
      "name": "Ghost Count",
      "description": "How many replay-capable historical attempts ECHO_DASH should select at once. 0 disables ghost rendering; ECHO_DASH supports up to 256 visible ghosts.",
      "default": 16,
      "min": 0,
      "max": 256
    },
    "visual-profile": {
      "type": "string",
      "name": "Visual Profile",
      "description": "A starting behavior profile. Custom exposes the raw configured ghost count without profile caps.",
      "default": "Multiverse",
      "one-of": ["Clean", "Competitive", "Multiverse", "Chaos", "Custom"]
    },
    "older-opacity-min": {
      "type": "int",
      "name": "Oldest Ghost Opacity",
      "default": 36,
      "min": 0,
      "max": 255
    },
    "older-opacity-max": {
      "type": "int",
      "name": "Newest Older-Ghost Opacity",
      "default": 104,
      "min": 0,
      "max": 255
    },
    "age-fade-strength": {
      "type": "float",
      "name": "Age Fade Strength",
      "default": 1.0,
      "min": 0.0,
      "max": 2.0
    },
    "priority-xray": {
      "type": "bool",
      "name": "Priority Trail X-Ray",
      "description": "Keep the blue Last Attempt and golden Best Recorded trails above busy level decoration where possible.",
      "default": true
    },

    "last-title": {
      "type": "title",
      "name": "Last Attempt"
    },
    "last-ghost-enabled": {
      "type": "bool",
      "name": "Show Last Attempt Priority",
      "default": true
    },
    "last-ghost-color": {
      "type": "rgb",
      "name": "Last Attempt Trail Color",
      "default": "#4aa3ff"
    },
    "last-ghost-opacity": {
      "type": "int",
      "name": "Last Attempt Ghost Opacity",
      "default": 190,
      "min": 0,
      "max": 255
    },
    "last-ghost-trail": {
      "type": "bool",
      "name": "Last Attempt Blue Trail",
      "default": true
    },

    "best-title": {
      "type": "title",
      "name": "Best Recorded Echo"
    },
    "best-ghost-enabled": {
      "type": "bool",
      "name": "Show Best Recorded Priority",
      "default": true
    },
    "best-ghost-color": {
      "type": "rgb",
      "name": "Best Recorded Trail Color",
      "default": "#ffd54a"
    },
    "best-ghost-opacity": {
      "type": "int",
      "name": "Best Recorded Ghost Opacity",
      "default": 220,
      "min": 0,
      "max": 255
    },
    "best-ghost-trail": {
      "type": "bool",
      "name": "Best Recorded Golden Trail",
      "default": true
    },

    "trails-title": {
      "type": "title",
      "name": "Priority Trails"
    },
    "trail-seconds": {
      "type": "float",
      "name": "Trail Length (seconds)",
      "default": 0.55,
      "min": 0.05,
      "max": 2.0
    },
    "trail-width": {
      "type": "float",
      "name": "Trail Width",
      "default": 1.8,
      "min": 0.5,
      "max": 6.0
    },
    "trail-opacity": {
      "type": "int",
      "name": "Trail Opacity",
      "default": 170,
      "min": 0,
      "max": 255
    },

    "death-title": {
      "type": "title",
      "name": "Death Intelligence"
    },
    "death-markers": {
      "type": "bool",
      "name": "World Death Markers",
      "description": "Show clustered death zones in world space. Analytics continue recording when hidden.",
      "default": true
    },
    "death-marker-scale": {
      "type": "float",
      "name": "Death Marker Scale",
      "default": 1.0,
      "min": 0.5,
      "max": 3.0
    },
    "death-labels": {
      "type": "bool",
      "name": "Death Marker Labels",
      "default": true
    },
    "death-xray": {
      "type": "bool",
      "name": "Death Marker X-Ray",
      "default": true
    },
    "heat-strip": {
      "type": "bool",
      "name": "Progress Death Heat Strip",
      "default": true
    },
    "heat-strip-opacity": {
      "type": "int",
      "name": "Heat Strip Opacity",
      "default": 170,
      "min": 0,
      "max": 255
    },

    "replay-title": {
      "type": "title",
      "name": "Replay Studio"
    },
    "default-playback-rate": {
      "type": "string",
      "name": "Default Playback Speed",
      "default": "1.00",
      "one-of": ["0.10", "0.25", "0.50", "1.00", "2.00"]
    },
    "default-camera-mode": {
      "type": "string",
      "name": "Default Camera",
      "default": "Recorded",
      "one-of": ["Recorded", "Follow", "Smooth", "Drone", "Dynamic Zoom", "Death Cam"]
    },

    "history-title": {
      "type": "title",
      "name": "History & Performance"
    },
    "recorder-sample-rate": {
      "type": "int",
      "name": "Recorder Sample Rate",
      "description": "Regular replay samples per second. Event samples can still be captured between regular samples.",
      "default": 120,
      "min": 30,
      "max": 240
    },
    "replay-retention": {
      "type": "int",
      "name": "Replay Archive Run Limit",
      "description": "Keep every finalized run as a replay until this high safety ceiling or the configured disk budget is reached. Default is 10,000 runs.",
      "default": 10000,
      "min": 256,
      "max": 100000
    },
    "disk-budget-mb": {
      "type": "int",
      "name": "Archive Disk Budget (MB)",
      "default": 2048,
      "min": 128,
      "max": 8192
    },
    "rendering-quality": {
      "type": "string",
      "name": "Rendering Quality",
      "default": "Auto",
      "one-of": ["Auto", "Full", "Balanced", "Performance"]
    },
    "diagnostics": {
      "type": "bool",
      "name": "Show ECHO_DASH Diagnostics",
      "default": false
    }
  }
}
